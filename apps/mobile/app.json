{
  "expo": {
    "name": "Grand City Race",
    "slug": "gcr26",
    "scheme": "grandcityrace",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./app-icons/ios/AppIcon.appiconset/AppIcon-1024.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gcr.app26",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Grand City Race uses your location in the background during a race, so distance quests and your team's trail keep working while your phone is in your pocket, and the hosts of your race can see where your team is. Nothing is recorded outside a game.",
        "NSLocationAlwaysUsageDescription": "Grand City Race uses your location in the background during a race, so distance quests and your team's trail keep working while your phone is in your pocket, and the hosts of your race can see where your team is. Nothing is recorded outside a game.",
        "NSLocationWhenInUseUsageDescription": "Grand City Race uses your location to unlock quests when your team reaches a place, and to show the hosts of your race where your team is."
      },
      "icon": {
        "light": "./app-icons/ios/AppIcon.appiconset/AppIcon-1024.png",
        "dark": "./app-icons/ios/AppIcon.appiconset/AppIcon-1024-dark.png",
        "tinted": "./app-icons/ios/AppIcon.appiconset/AppIcon-1024-tinted.png"
      }
    },
    "android": {
      "package": "com.gcrace.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./app-icons/android/res/mipmap-xxxhdpi/ic_launcher_foreground.png",
        "monochromeImage": "./app-icons/android/res/mipmap-xxxhdpi/ic_launcher_monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-notifications",
      [
        "expo-location",
        {
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./app-icons/ios/AppIcon.appiconset/AppIcon-1024.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "da8ba6275eca",
          "project": "grand-city-race-app",
          "url": "https://de.sentry.io/"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ec849fa3-413f-4770-a121-e51f1fa7a37a"
      }
    },
    "owner": "timschaeren"
  }
}
