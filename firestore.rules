rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function myUserPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    // Reading a field that isn't there is an error in rules, and documents written
    // by older app versions may lack isAdmin or teamId — so every lookup defaults.
    function myUserData() {
      return get(myUserPath()).data;
    }

    // Platform admin: may run every game and manage players
    function isAdmin() {
      return isAuth()
        && exists(myUserPath())
        && myUserData().get('isAdmin', false) == true;
    }

    // Hosts are listed on the game they run. A game without hostIds can only be
    // run by platform admins, which keeps games created before hosting existed safe.
    function gameHosts(gameId) {
      return exists(/databases/$(database)/documents/games/$(gameId))
        ? get(/databases/$(database)/documents/games/$(gameId)).data.get('hostIds', [])
        : [];
    }

    function myTeamId() {
      return isAuth() && exists(myUserPath()) ? myUserData().get('teamId', null) : null;
    }

    // Has this user joined the game? Joining writes a membership document,
    // which is what lets them create or join a team in it.
    function hasJoined(gameId) {
      return isAuth()
        && exists(/databases/$(database)/documents/games/$(gameId)/players/$(request.auth.uid));
    }

    // A player may add or remove only themselves from a team's member list
    function joiningTeamSelf() {
      return isAuth()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
        && !(request.auth.uid in resource.data.memberIds)
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && resource.data.memberIds.hasOnly(request.resource.data.memberIds);
    }

    function leavingTeamSelf() {
      return isAuth()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
        && request.auth.uid in resource.data.memberIds
        && !(request.auth.uid in request.resource.data.memberIds)
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
        && request.resource.data.memberIds.hasOnly(resource.data.memberIds);
    }

    // A gameplay entry a player may write for their own team
    function isOwnGameplayEntry() {
      return isAuth()
        && request.resource.data.teamId == myTeamId()
        && request.resource.data.type in ['quest_solved', 'team_finished', 'hint_revealed', 'item_bought'];
    }

    function canManageGame(gameId) {
      return isAdmin() || (isAuth() && request.auth.uid in gameHosts(gameId));
    }

    // Users: own doc is readable/writable by self; admins can read all
    // create is allowed for any authenticated user so signup can write the initial doc
    match /users/{uid} {
      // Own doc, admin, or a teammate (same teamId, non-null)
      // Note: isAdmin() uses get() which works for single-doc reads but not list queries;
      // list queries (e.g. where documentId() in [...]) use the allow list rule below.
      allow read:   if isAuth() && (
                      request.auth.uid == uid
                      || (resource.data.get('teamId', null) != null
                          && resource.data.get('teamId', null) == myTeamId())
                      || isAdmin()
                    );
      allow list:   if isAdmin();
      allow create: if isAuth() && request.auth.uid == uid;
      // Users may update their own doc but cannot promote themselves to admin
      allow update: if isAdmin()
                    || (request.auth.uid == uid
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin']))
                    // A host moving a player of their game between teams, on the
                    // Teams page: the team and nothing else
                    || (resource.data.get('gameId', null) != null
                        && canManageGame(resource.data.gameId)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teamId']));
      // Deleting your own account is a requirement of both app stores
      allow delete: if isAdmin() || request.auth.uid == uid;
    }

    // Games + nested quests: authenticated users read; admins write
    match /games/{gameId} {
      allow read:   if isAuth();
      // Whoever creates a game must list themselves as a host
      allow create: if isAdmin() || (isAuth() && request.auth.uid in request.resource.data.hostIds);
      allow update, delete: if canManageGame(gameId);

      match /quests/{questId} {
        allow read:  if isAuth();
        allow write: if canManageGame(gameId);
      }

      // Chat: one thread per team. A team sees only its own thread; hosts see all.
      match /messages/{messageId} {
        allow read: if isAuth() && (resource.data.teamId == myTeamId() || canManageGame(gameId));
        allow create: if (
                        isAuth()
                        && request.resource.data.teamId == myTeamId()
                        && request.resource.data.authorId == request.auth.uid
                        && request.resource.data.fromHost == false
                      ) || canManageGame(gameId);
        allow update: if canManageGame(gameId);
        // Authors may delete their own messages, which is how account deletion
        // clears what a person wrote
        allow delete: if canManageGame(gameId)
                      || (isAuth() && resource.data.authorId == request.auth.uid);
      }

      // Who has joined this game. A player writes their own entry when they
      // enter the invite code; hosts read them all, which is how a host sees
      // their players without access to the platform's whole user list.
      match /players/{playerId} {
        // Players in the same game can see each other's names, which is how the
        // team picker shows who is already on a team before you join it
        allow read:   if isAuth() && (playerId == request.auth.uid
                                      || hasJoined(gameId)
                                      || canManageGame(gameId));
        // Everyone in the game can read this list, so it never holds a position
        // or a push token: those live in private/{uid} below.
        allow create: if isAuth() && playerId == request.auth.uid
                      && request.resource.data.id == request.auth.uid
                      && !request.resource.data.keys().hasAny(['lastLocation', 'pushToken']);
        allow update: if isAuth() && playerId == request.auth.uid
                      && !request.resource.data.keys().hasAny(['lastLocation', 'pushToken']);
        allow delete: if isAuth() && (playerId == request.auth.uid || canManageGame(gameId));
      }

      // What only a player and the game's hosts may see: the player's last
      // position, for the live map, and their push token.
      match /private/{playerId} {
        allow read:   if (isAuth() && playerId == request.auth.uid) || canManageGame(gameId);
        allow create: if isAuth() && playerId == request.auth.uid
                      && request.resource.data.keys().hasOnly(['lastLocation', 'pushToken']);
        // A host may clear the position when resetting the game, nothing else
        allow update: if (isAuth() && playerId == request.auth.uid
                          && request.resource.data.keys().hasOnly(['lastLocation', 'pushToken']))
                      || (canManageGame(gameId)
                          && request.resource.data.diff(resource.data).affectedKeys()
                               .hasOnly(['lastLocation']));
        allow delete: if (isAuth() && playerId == request.auth.uid) || canManageGame(gameId);
      }

      // Wrong answers: teams write their own, only hosts read them. Teams must not
      // see what other teams have tried.
      match /attempts/{attemptId} {
        allow read: if canManageGame(gameId);
        allow create: if isAuth() && request.resource.data.teamId == myTeamId();
        allow update, delete: if canManageGame(gameId);
      }

      // Activity feed: 'public' entries are readable by everyone in the game,
      // 'team' entries only by that team and admins. Players may only write
      // their own team's gameplay entries, and nobody but an admin may edit one.
      match /activity/{entryId} {
        allow read: if isAuth() && (
                      resource.data.visibility == 'public'
                      || resource.data.teamId == myTeamId()
                      || canManageGame(gameId)
                    );
        // Entry ids are derived from the quest, so two teammates acting at the same
        // moment — or any retried write — land on the same document. That has to be
        // an allowed overwrite: these entries travel in the same batch as the team's
        // progress, and refusing one would stop the team from advancing.
        allow create: if isOwnGameplayEntry() || canManageGame(gameId);
        allow update: if (isOwnGameplayEntry() && resource.data.teamId == myTeamId())
                      || canManageGame(gameId);
        allow delete: if canManageGame(gameId);
      }

      // The race recap, built by a host in the console once the race is over.
      // It tells what each team bought, which the activity feed keeps to the
      // team, so players may read it only after a host has shown it to them.
      match /recap/{docId} {
        allow read:  if canManageGame(gameId)
                     || (hasJoined(gameId) && resource.data.publishedAt != null);
        allow write: if canManageGame(gameId);
      }
    }

    // Teams: authenticated users read; admins write
    // Team members may update only the quest progress fields
    match /teams/{id} {
      allow read:   if isAuth();
      // A player who has joined the game may start a team, with themselves in it
      allow create: if canManageGame(request.resource.data.gameId)
                    || (hasJoined(request.resource.data.gameId)
                        && request.resource.data.memberIds == [request.auth.uid]
                        && request.resource.data.completedQuestIds == []
                        && request.resource.data.currentQuestId == null
                        && request.resource.data.finishedAt == null);
      allow delete: if canManageGame(resource.data.gameId);
      // The team-member clause comes first so a player's own writes are decided
      // without any document lookups at all. Curses and robberies (cursedUntil,
      // robbedAt) are only ever set by the server, never by a team.
      allow update: if (isAuth()
                        && request.auth.uid in resource.data.memberIds
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['currentQuestId', 'completedQuestIds', 'finishedAt',
                                       'pausedMsAtFinish', 'questProgress', 'coins', 'hintsRevealed',
                                       'teamChatReadAt', 'activeCompassUntil',
                                       'activeRadarUntil', 'shields'])
                        // Never back to a quest already solved: a phone that was
                        // offline on an old quest would otherwise set its team back.
                        // Only a change is checked, so writes that leave the quest
                        // alone (hints, items) always go through.
                        && (request.resource.data.get('currentQuestId', null)
                              == resource.data.get('currentQuestId', null)
                            || !(request.resource.data.get('currentQuestId', null)
                                 in resource.data.get('completedQuestIds', []))))
                    // Joining needs a membership record; leaving never does, or a
                    // player a host added by hand could never remove themselves
                    || (hasJoined(resource.data.gameId) && joiningTeamSelf())
                    || leavingTeamSelf()
                    || canManageGame(resource.data.gameId);

      // Coin ledger: a record of admin adjustments; players may read their own team's history
      match /coinLedger/{entryId} {
        allow read:  if isAuth();
        allow write: if canManageGame(get(/databases/$(database)/documents/teams/$(id)).data.gameId);
      }
    }

    // App-wide settings, such as the oldest app version still let in. Read
    // before sign-in too, so an outdated build is stopped at the door.
    match /settings/{id} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // Location trail: players write their own points; only admins read
    match /trail/{trailId} {
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow read:   if canManageGame(resource.data.gameId)
                    || (isAuth() && resource.data.userId == request.auth.uid);
      // Someone deleting their account takes their location history with them,
      // and resetting a game clears the trails it collected
      allow delete: if (isAuth() && resource.data.userId == request.auth.uid)
                    || canManageGame(resource.data.gameId);
    }
  }
}
