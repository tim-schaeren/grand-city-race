rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Everything that decides a race (progress, coins, items, joining, the
    // race's own state) is written by the server functions, which bypass
    // these rules. What remains here is what people write directly: their
    // profile, their position and trail, chat, and a host's own content.

    function signedIn() {
      return request.auth != null;
    }

    // Platform admins carry a claim on their sign-in, which only the server sets
    function isAdmin() {
      return signedIn() && request.auth.token.get('admin', false) == true;
    }

    function gameDoc(gameId) {
      return /databases/$(database)/documents/games/$(gameId);
    }

    function playerDoc(gameId) {
      return /databases/$(database)/documents/games/$(gameId)/players/$(request.auth.uid);
    }

    // Hosts are listed on the game they run; platform admins run every game
    function runs(gameData) {
      return isAdmin() || (signedIn() && request.auth.uid in gameData.get('hostIds', []));
    }

    function isHost(gameId) {
      return isAdmin() || (signedIn() && exists(gameDoc(gameId)) && runs(get(gameDoc(gameId)).data));
    }

    function isMember(gameId) {
      return signedIn() && exists(playerDoc(gameId));
    }

    // The caller's team in a game, or null
    function myTeam(gameId) {
      return isMember(gameId) ? get(playerDoc(gameId)).data.get('teamId', null) : null;
    }

    function onTeam(gameId, teamId) {
      return teamId != null && myTeam(gameId) == teamId;
    }

    // ── What may be typed ─────────────────────────────────────────────────
    // Lengths and ranges match packages/shared/src/limits.ts; change both.

    function textOf(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function numberIn(value, min, max) {
      return value is number && value >= min && value <= max;
    }

    function pointOk(p) {
      return p is map && numberIn(p.get('lat', null), -90, 90) && numberIn(p.get('lng', null), -180, 180);
    }

    function optionalNumber(d, changed, key, min, max) {
      return !(key in changed) || d.get(key, null) == null || numberIn(d.get(key, null), min, max);
    }

    // Only which items: their numbers are kept in range wherever they're read
    // (shopConfig in packages/shared), since checking six items' settings here
    // runs past the rules' budget of expressions
    function shopOk(shop) {
      return shop is map && shop.keys().hasOnly(['compass', 'radar', 'shield', 'curse', 'robbery', 'donate']);
    }

    // A game's settings, as hosts save them. Only the fields being changed are
    // checked: games saved before these checks stay editable, and a big game
    // stays within the rules' budget of expressions.
    function gameOk(d, changed) {
      return (!('name' in changed) || textOf(d.get('name', null), 1, 60))
        && (!('city' in changed) || textOf(d.get('city', ''), 0, 60))
        && (!('timeZone' in changed) || !('timeZone' in d) || textOf(d.timeZone, 1, 64))
        && (!('hotlineNumber' in changed) || d.get('hotlineNumber', null) == null || textOf(d.hotlineNumber, 0, 30))
        && (!('themeId' in changed) || !('themeId' in d) || d.themeId in ['basic', 'retro', 'night', 'arcade', 'bern'])
        && (!('cityCoordinates' in changed) || d.get('cityCoordinates', null) == null || pointOk(d.cityCoordinates))
        && (!('startDateTime' in changed) || d.get('startDateTime', null) is number)
        && optionalNumber(d, changed, 'maxTeamSize', 1, 100)
        && optionalNumber(d, changed, 'maxTeamSpreadMeters', 1, 100000)
        && optionalNumber(d, changed, 'startingCoins', 0, 100000)
        && optionalNumber(d, changed, 'coinsPerQuest', 0, 100000)
        && optionalNumber(d, changed, 'hintCost', 0, 100000)
        && (!('questOrder' in changed) || (d.get('questOrder', []) is list && d.get('questOrder', []).size() <= 200))
        && (!('shop' in changed) || shopOk(d.get('shop', {})));
    }

    // A quest's shape. What's inside its lists (each block's text, each
    // answer) is clipped by the server after the save; see cleanQuest.
    function questOk(q) {
      return q.keys().hasOnly(['title', 'trigger', 'task', 'description', 'navigationHint', 'isActive',
                               'fenceRadius', 'location', 'distanceMeters', 'showDistanceProgress',
                               'answers', 'hints', 'durationSeconds'])
        && textOf(q.get('title', null), 1, 80)
        && q.get('trigger', null) in ['location', 'distance', 'none']
        && q.get('task', null) in ['answer', 'timer', 'continue']
        && q.get('description', []) is list && q.get('description', []).size() <= 30
        && q.get('navigationHint', []) is list && q.get('navigationHint', []).size() <= 30
        && q.get('isActive', true) is bool
        && (!('fenceRadius' in q) || numberIn(q.fenceRadius, 1, 5000))
        && (!('location' in q) || pointOk(q.location))
        && (!('distanceMeters' in q) || numberIn(q.distanceMeters, 1, 100000))
        && (!('showDistanceProgress' in q) || q.showDistanceProgress is bool)
        && (!('answers' in q) || (q.answers is list && q.answers.size() <= 30))
        && (!('hints' in q) || (q.hints is list && q.hints.size() <= 10))
        && (!('durationSeconds' in q) || numberIn(q.durationSeconds, 1, 86400));
    }

    // ── People ────────────────────────────────────────────────────────────

    // Profiles are private: names in a game come from its player list
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['name', 'email', 'createdAt', 'acceptedTermsAt', 'pushTokens'])
                    && textOf(request.resource.data.name, 1, 60)
                    && (!('email' in request.resource.data) || textOf(request.resource.data.email, 0, 200))
                    && request.resource.data.get('pushTokens', []).size() <= 10;
      allow update: if signedIn() && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'pushTokens'])
                    && textOf(request.resource.data.name, 1, 60)
                    && request.resource.data.get('pushTokens', []).size() <= 10;
    }

    // App-wide settings, such as the oldest app version still let in. Read
    // before sign-in too, so an outdated build is stopped at the door.
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // A player finds the games they are in through their own entries;
    // platform admins see everyone's, and every team, across games
    match /{path=**}/players/{uid} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /{path=**}/teams/{teamId} {
      allow read: if isAdmin();
    }

    // Hosts read every team's private state in their game at once
    match /{path=**}/private/{docId} {
      allow read: if isHost(resource.data.gameId);
    }

    // ── A game ────────────────────────────────────────────────────────────

    match /games/{gameId} {
      allow read: if runs(resource.data) || isMember(gameId);
      // Whoever creates a game hosts it, it starts in the future, and neither
      // paused nor over
      allow create: if signedIn()
                    && (request.resource.data.hostIds == [request.auth.uid] || isAdmin())
                    && request.resource.data.startDateTime is number
                    && request.resource.data.startDateTime > request.time.toMillis()
                    && request.resource.data.get('pausedAt', null) == null
                    && request.resource.data.get('endedAt', null) == null
                    && request.resource.data.get('totalPausedMs', 0) == 0
                    && !request.resource.data.keys().hasAny(['recapPublishedAt', 'trailClearedAt', 'startHeld', 'heldNoticeAt', 'testedAt', 'joinCode'])
                    && gameOk(request.resource.data, request.resource.data.keys().toSet());
      // Hosts edit the game's settings; who hosts it, the race's state and
      // the join code (unique across games) change only through the server
      allow update: if runs(resource.data)
                    && !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['hostIds', 'pausedAt', 'endedAt', 'totalPausedMs', 'recapPublishedAt', 'trailClearedAt', 'startHeld', 'heldNoticeAt', 'testedAt', 'joinCode'])
                    && gameOk(request.resource.data, request.resource.data.diff(resource.data).affectedKeys());

      match /quests/{questId} {
        allow read, delete: if isHost(gameId);
        allow create, update: if isHost(gameId) && questOk(request.resource.data);
      }

      match /players/{uid} {
        allow read: if isMember(gameId) || isHost(gameId);
      }

      // A player's last position: the live map, and the team's spread check
      match /positions/{uid} {
        allow read: if isHost(gameId) || onTeam(gameId, resource.data.teamId);
        allow create, update: if signedIn() && request.auth.uid == uid
                              && request.resource.data.uid == uid
                              && onTeam(gameId, request.resource.data.teamId)
                              && request.resource.data.keys().hasOnly(['uid', 'teamId', 'lat', 'lng', 'updatedAt'])
                              && pointOk(request.resource.data) && request.resource.data.updatedAt is number;
        allow delete: if (signedIn() && request.auth.uid == uid) || isHost(gameId);
      }

      // Route points, for the live map and the recap; only hosts read them
      match /trail/{pointId} {
        allow read: if isHost(gameId);
        allow create: if signedIn()
                      && request.resource.data.uid == request.auth.uid
                      && onTeam(gameId, request.resource.data.teamId)
                      && request.resource.data.keys().hasOnly(['uid', 'teamId', 'lat', 'lng', 't'])
                      && pointOk(request.resource.data) && request.resource.data.t is number;
      }

      match /teams/{teamId} {
        allow read: if isMember(gameId) || isHost(gameId);

        // Coins, items and the current quest: the team and its hosts only.
        // Each side may only mark the chat as read.
        match /private/{docId} {
          allow read: if isHost(gameId) || onTeam(gameId, teamId);
          allow update: if (onTeam(gameId, teamId)
                            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teamChatReadAt']))
                        || (isHost(gameId)
                            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hostChatReadAt']));
        }

        match /coinLedger/{entryId} {
          allow read: if isHost(gameId) || onTeam(gameId, teamId);
        }
      }

      // The board: public entries for everyone in the game, team entries for
      // that team. The server writes the race's entries; hosts post notes.
      match /activity/{entryId} {
        allow read: if isHost(gameId)
                    || (isMember(gameId)
                        && (resource.data.visibility == 'public' || onTeam(gameId, resource.data.teamId)));
        allow create: if isHost(gameId)
                      && request.resource.data.keys().hasOnly(['type', 'at', 'visibility', 'teamId', 'teamName', 'text',
                                                               'itemType', 'itemTypes', 'amount', 'durationMinutes'])
                      && request.resource.data.type in ['admin_note', 'price_changed', 'flash_sale']
                      && request.resource.data.visibility == 'public'
                      && request.resource.data.get('teamId', null) == null
                      && request.resource.data.get('teamName', null) == null
                      && request.resource.data.at is number
                      && (!('text' in request.resource.data) || textOf(request.resource.data.text, 1, 500));
        allow delete: if isHost(gameId);
      }

      // Chat: one thread per team, between that team and the game's hosts
      match /messages/{messageId} {
        allow read: if isHost(gameId) || onTeam(gameId, resource.data.teamId);
        allow create: if signedIn()
                      && request.resource.data.keys().hasOnly(['teamId', 'authorId', 'authorName', 'fromHost', 'text', 'sentAt'])
                      && request.resource.data.authorId == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
                      && request.resource.data.authorName is string && request.resource.data.authorName.size() <= 60
                      && ((request.resource.data.fromHost == false && onTeam(gameId, request.resource.data.teamId))
                          || (request.resource.data.fromHost == true && isHost(gameId)));
        allow delete: if isHost(gameId);
      }

      // Wrong answers, for the hosts
      match /attempts/{attemptId} {
        allow read: if isHost(gameId);
      }

      // The recap: players may read it once a host has shown it
      match /recap/{docId} {
        allow read: if isHost(gameId) || (isMember(gameId) && resource.data.publishedAt != null);
      }
    }
  }
}
