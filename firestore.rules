rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Everything that decides a race (progress, coins, items, joining, the
    // race's own state) is written by the server functions, which bypass
    // these rules. What remains here is what people write directly: their
    // profile, their position and trail, chat, and a host's own content.

    function signedIn() {
      return request.auth != null;
    }

    // Platform admins carry a claim on their sign-in, which only the server sets
    function isAdmin() {
      return signedIn() && request.auth.token.get('admin', false) == true;
    }

    function gameDoc(gameId) {
      return /databases/$(database)/documents/games/$(gameId);
    }

    function playerDoc(gameId) {
      return /databases/$(database)/documents/games/$(gameId)/players/$(request.auth.uid);
    }

    // Hosts are listed on the game they run; platform admins run every game
    function runs(gameData) {
      return isAdmin() || (signedIn() && request.auth.uid in gameData.get('hostIds', []));
    }

    function isHost(gameId) {
      return isAdmin() || (signedIn() && exists(gameDoc(gameId)) && runs(get(gameDoc(gameId)).data));
    }

    function isMember(gameId) {
      return signedIn() && exists(playerDoc(gameId));
    }

    // The caller's team in a game, or null
    function myTeam(gameId) {
      return isMember(gameId) ? get(playerDoc(gameId)).data.get('teamId', null) : null;
    }

    function onTeam(gameId, teamId) {
      return teamId != null && myTeam(gameId) == teamId;
    }

    // ── People ────────────────────────────────────────────────────────────

    // Profiles are private: names in a game come from its player list
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['name', 'email', 'createdAt', 'acceptedTermsAt', 'pushTokens'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60;
      allow update: if signedIn() && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'pushTokens'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
                    && request.resource.data.get('pushTokens', []).size() <= 10;
    }

    // App-wide settings, such as the oldest app version still let in. Read
    // before sign-in too, so an outdated build is stopped at the door.
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // A player finds the games they are in through their own entries;
    // platform admins see everyone's, and every team, across games
    match /{path=**}/players/{uid} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /{path=**}/teams/{teamId} {
      allow read: if isAdmin();
    }

    // Hosts read every team's private state in their game at once
    match /{path=**}/private/{docId} {
      allow read: if isHost(resource.data.gameId);
    }

    // ── A game ────────────────────────────────────────────────────────────

    match /games/{gameId} {
      allow read: if runs(resource.data) || isMember(gameId);
      // Whoever creates a game hosts it, it starts in the future, and neither
      // paused nor over
      allow create: if signedIn()
                    && (request.resource.data.hostIds == [request.auth.uid] || isAdmin())
                    && request.resource.data.startDateTime is number
                    && request.resource.data.startDateTime > request.time.toMillis()
                    && request.resource.data.get('pausedAt', null) == null
                    && request.resource.data.get('endedAt', null) == null
                    && request.resource.data.get('totalPausedMs', 0) == 0
                    && !request.resource.data.keys().hasAny(['recapPublishedAt', 'trailClearedAt', 'startHeld', 'heldNoticeAt', 'testedAt']);
      // Hosts edit the game's settings; who hosts it and the race's state
      // change only through the server
      allow update: if runs(resource.data)
                    && !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['hostIds', 'pausedAt', 'endedAt', 'totalPausedMs', 'recapPublishedAt', 'trailClearedAt', 'startHeld', 'heldNoticeAt', 'testedAt']);

      match /quests/{questId} {
        allow read, write: if isHost(gameId);
      }

      match /players/{uid} {
        allow read: if isMember(gameId) || isHost(gameId);
      }

      // A player's last position: the live map, and the team's spread check
      match /positions/{uid} {
        allow read: if isHost(gameId) || onTeam(gameId, resource.data.teamId);
        allow create, update: if signedIn() && request.auth.uid == uid
                              && request.resource.data.uid == uid
                              && onTeam(gameId, request.resource.data.teamId)
                              && request.resource.data.keys().hasOnly(['uid', 'teamId', 'lat', 'lng', 'updatedAt']);
        allow delete: if (signedIn() && request.auth.uid == uid) || isHost(gameId);
      }

      // Route points, for the live map and the recap; only hosts read them
      match /trail/{pointId} {
        allow read: if isHost(gameId);
        allow create: if signedIn()
                      && request.resource.data.uid == request.auth.uid
                      && onTeam(gameId, request.resource.data.teamId)
                      && request.resource.data.keys().hasOnly(['uid', 'teamId', 'lat', 'lng', 't']);
      }

      match /teams/{teamId} {
        allow read: if isMember(gameId) || isHost(gameId);

        // Coins, items and the current quest: the team and its hosts only.
        // Each side may only mark the chat as read.
        match /private/{docId} {
          allow read: if isHost(gameId) || onTeam(gameId, teamId);
          allow update: if (onTeam(gameId, teamId)
                            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teamChatReadAt']))
                        || (isHost(gameId)
                            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hostChatReadAt']));
        }

        match /coinLedger/{entryId} {
          allow read: if isHost(gameId) || onTeam(gameId, teamId);
        }
      }

      // The board: public entries for everyone in the game, team entries for
      // that team. The server writes the race's entries; hosts post notes.
      match /activity/{entryId} {
        allow read: if isHost(gameId)
                    || (isMember(gameId)
                        && (resource.data.visibility == 'public' || onTeam(gameId, resource.data.teamId)));
        allow create, update, delete: if isHost(gameId);
      }

      // Chat: one thread per team, between that team and the game's hosts
      match /messages/{messageId} {
        allow read: if isHost(gameId) || onTeam(gameId, resource.data.teamId);
        allow create: if signedIn()
                      && request.resource.data.keys().hasOnly(['teamId', 'authorId', 'authorName', 'fromHost', 'text', 'sentAt'])
                      && request.resource.data.authorId == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
                      && request.resource.data.authorName is string && request.resource.data.authorName.size() <= 60
                      && ((request.resource.data.fromHost == false && onTeam(gameId, request.resource.data.teamId))
                          || (request.resource.data.fromHost == true && isHost(gameId)));
        allow delete: if isHost(gameId);
      }

      // Wrong answers, for the hosts
      match /attempts/{attemptId} {
        allow read: if isHost(gameId);
      }

      // The recap: players may read it once a host has shown it
      match /recap/{docId} {
        allow read: if isHost(gameId) || (isMember(gameId) && resource.data.publishedAt != null);
      }
    }
  }
}
