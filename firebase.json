{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5001
    },
    "ui": {
      "enabled": true,
      "port": 4000
    }
  },
  "functions": [
    {
      "source": "apps/functions/dist",
      "codebase": "default",
      "runtime": "nodejs22",
      "predeploy": [
        "npm run build --workspace=apps/functions"
      ]
    }
  ]
}
